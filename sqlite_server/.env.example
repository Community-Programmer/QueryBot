# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# Database Configuration (for future use)
# DATABASE_URL=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=querybot
# DB_USER=
# DB_PASSWORD=

# JWT Configuration (for future use)
# JWT_SECRET=your-super-secret-jwt-key
# JWT_EXPIRES_IN=7d

# Logging Configuration
LOG_LEVEL=info

# API Configuration
API_VERSION=v1
API_PREFIX=/api