# LangGraph agent environment variables
# Copy to `.env` and fill in real values.

# ---------------------------------------------------------------------------
# Model  (required)
# ---------------------------------------------------------------------------
# From https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Groq retires models periodically. If a run fails with `model_not_found`, pick a
# current one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
TEMPERATURE=0
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Dataset service
# ---------------------------------------------------------------------------
SQLITE_SERVICE_URL=http://localhost:3001
# Must match SERVICE_TOKEN in sqlite_server/.env and server/.env.
SERVICE_TOKEN=change-me-shared-between-services
SQLITE_REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------------
# Chart generation
# ---------------------------------------------------------------------------
# Charts render inside a Docker container with no network access. Set to false
# on hosts without a Docker daemon: answers, tables and insights still work and
# chart requests report that charts are unavailable.
CHART_DOCKER_ENABLED=true
CHART_EXECUTOR_IMAGE=querybot-chart-executor
CHART_OUTPUT_DIR=./generated_charts
CHART_TIMEOUT=120

# ---------------------------------------------------------------------------
# Query limits
# ---------------------------------------------------------------------------
MAX_RESULT_ROWS=5000
# Rows sent to the model for analysis; the full result still reaches the client.
LLM_SAMPLE_ROWS=30

# ---------------------------------------------------------------------------
# Tracing  (optional)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querybot-agent
