# Environment Configuration for QueryBot Authentication API
# Copy this file to .env and update with your actual values

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration
DATABASE_URL=your-database-url-change-in-production

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Optional: For development with SQLite (comment out DATABASE_URL above)
# DATABASE_URL=sqlite:///instance/querybot.db